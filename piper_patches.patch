+def _add_trainer_args(parser: argparse.ArgumentParser) -> None:
+    """
+    Adds the Lightning Trainer arguments that we actually use in this
+    project. We do this by hand because Lightning 2.x removed the
+    convenience method that used to do it for us.
+    """
+    group = parser.add_argument_group("Lightning Trainer")
+    group.add_argument("--accelerator", type=str, default="auto",
+                       help="Accelerator type: cpu, gpu, auto, etc.")
+    group.add_argument("--devices", type=str, default="auto",
+                       help="Number of devices to use (1, 2, ..., or auto).")
+    group.add_argument("--max_epochs", type=int, default=None,
+                       help="Stop after this many epochs.")
+    group.add_argument("--min_epochs", type=int, default=None,
+                       help="Run at least this many epochs.")
+    group.add_argument("--precision", type=str, default="32-true",
+                       help="Numeric precision: 32, 32-true, 16-mixed, bf16-mixed, etc.")
+    group.add_argument("--default_root_dir", type=str, default=None,
+                       help="Where Lightning saves logs and checkpoints.")
+    group.add_argument("--resume_from_checkpoint", type=str, default=None,
+                       help="Path to a checkpoint to resume training from.")
+    group.add_argument("--log_every_n_steps", type=int, default=10,
+                       help="How often to log metrics to TensorBoard.")
+    group.add_argument("--num_sanity_val_steps", type=int, default=0,
+                       help="Sanity validation steps before training starts.")
+    group.add_argument("--limit_val_batches", type=float, default=0.0,
+                       help="Fraction of val set to use (0.0 disables validation).")
+    group.add_argument("--gradient_clip_val", type=float, default=None,
+                       help="Optional gradient clipping value.")
+
+
+def _build_trainer(args: argparse.Namespace) -> Trainer:
+    """
+    Constructs a Trainer using only the arguments the user actually
+    provided. Anything left at the default None is omitted so Lightning
+    picks its own default.
+    """
+    # Devices needs to be int if numeric, otherwise leave as string.
+    devices = args.devices
+    if isinstance(devices, str) and devices.isdigit():
+        devices = int(devices)
+
+    # Precision needs to be normalised. People may pass "32" but Lightning
+    # 2.x wants "32-true" for the full precision case.
+    precision = args.precision
+    if precision == "32":
+        precision = "32-true"
+    elif precision == "16":
+        precision = "16-mixed"
+
+    trainer_kwargs = {
+        "accelerator": args.accelerator,
+        "devices": devices,
+        "precision": precision,
+        "log_every_n_steps": args.log_every_n_steps,
+        "num_sanity_val_steps": args.num_sanity_val_steps,
+        "limit_val_batches": args.limit_val_batches,
+    }
+    if args.max_epochs is not None:
+        trainer_kwargs["max_epochs"] = args.max_epochs
+    if args.min_epochs is not None:
+        trainer_kwargs["min_epochs"] = args.min_epochs
+    if args.default_root_dir is not None:
+        trainer_kwargs["default_root_dir"] = args.default_root_dir
+    if args.gradient_clip_val is not None:
+        trainer_kwargs["gradient_clip_val"] = args.gradient_clip_val
+
+    return Trainer(**trainer_kwargs)
+
+
