+    def training_step(self, batch: Batch, batch_idx: int):
+        # Lightning 2.x: we run the generator and discriminator updates
+        # ourselves because automatic alternating between two optimizers
+        # was removed.
+        opt_g, opt_d = self.optimizers()
+
+        # Generator step
+        opt_g.zero_grad()
+        loss_g = self.training_step_g(batch)
+        self.manual_backward(loss_g)
+        opt_g.step()
+
+        # Discriminator step, using the cached y and y_hat from the
+        # generator step above.
+        opt_d.zero_grad()
+        loss_d = self.training_step_d(batch)
+        self.manual_backward(loss_d)
+        opt_d.step()
+
+        # Step the learning rate schedulers once per epoch. Lightning
+        # does this automatically only in automatic optimization mode.
+        if self.trainer.is_last_batch:
+            schedulers = self.lr_schedulers()
+            if schedulers is not None:
+                if not isinstance(schedulers, (list, tuple)):
+                    schedulers = [schedulers]
+                for sch in schedulers:
+                    sch.step()
+
+        # Combined loss is what gets logged as the headline number
+        # for this step.
+        total = loss_g.detach() + loss_d.detach()
+        self.log('train_loss', total, prog_bar=True)
+        return total
 
