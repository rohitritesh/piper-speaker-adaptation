# ======================================================================
# Large third party / generated content that must never be committed
# ======================================================================

# Third party Piper source. The marker clones this fresh via
# setup_piper.sh, so we never commit our local copy.
piper/

# Python virtual environment.
venv/
env/
.venv/

# ======================================================================
# Datasets (downloaded fresh, never committed)
# ======================================================================
data/LJSpeech-1.1/
data/lj_subset/
data/lj_subset_processed/
data/*.tar.bz2
data/*.tar.gz
data/*.zip

# ======================================================================
# Model checkpoints and exported models (large, regenerated by training)
# ======================================================================
checkpoints/amy_medium_base.ckpt
checkpoints/amy_medium_base.onnx
checkpoints/expA/
checkpoints/expB/
*.ckpt
*.onnx
*.pt
*.pth

# ======================================================================
# Training logs and Lightning artifacts
# ======================================================================
# Ignore the heavy checkpoint files inside the lightning_logs tree and
# the large raw stdout logs. The small metrics.csv files are kept (they
# are not matched by these rules) so loss curves remain reproducible.
logs/**/lightning_logs/**/checkpoints/
logs/**/training_stdout.log
logs/**/lightning_logs/**/hparams.yaml

# ======================================================================
# Audio output
# ======================================================================
# NOTE: we intentionally KEEP wav_examples/*.wav in the repository.
# The 20 generated samples are small (a few MB total) and are the main
# demonstrable output of the project, so they are worth showing on
# GitHub. If you would rather not commit them, uncomment the next line.
# wav_examples/*.wav

# ======================================================================
# Build artifacts
# ======================================================================
# Cython compiled outputs (regenerated by build_monotonic_align.sh)
*.so
**/monotonic_align/core.c

# ======================================================================
# Python caches and bytecode
# ======================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ======================================================================
# Windows / WSL cruft
# ======================================================================
*:Zone.Identifier
Thumbs.db
desktop.ini

# ======================================================================
# macOS cruft
# ======================================================================
.DS_Store
.AppleDouble
.LSOverride

# ======================================================================
# Editor and IDE files
# ======================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ======================================================================
# Backup files
# ======================================================================
*.original
*.bak
*.orig
